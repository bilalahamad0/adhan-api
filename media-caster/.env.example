TV_IP=192.168.1.XXX
DEVICE_NAME=Google Display
LOCATION_CITY=CityName
LOCATION_COUNTRY=CountryCode
LOCATION_METHOD=2
TIMEZONE=Country/CityName
HOST_IP=192.168.1.YYY
# Optional: Explicit coordinates (prevents geocoding fallback)
# LATITUDE=37.3688
# LONGITUDE=-122.0363

# Direct Firestore sync for the operations dashboard.
# Base64-encoded Firebase service account JSON from project adhan-79908.
# Generate at: Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# Then: base64 -i firebase-service-key.json (paste the output below)
FIREBASE_SERVICE_KEY=

# Optional: persistent playback log directory (recommended for data retention across deployments)
# Default if omitted: ~/.adhan-data
# PLAYBACK_DATA_DIR=/home/pi/.adhan-data

# --- Morning clips (Shuruq / Ishraq) -------------------------------------
# Two short procedural animations cast to the display in the early morning, both
# purely decorative and SILENT (they may play while people are still asleep, so
# they light up the display and make no sound). Neither is a prayer, so neither
# plays adhan audio, touches the TV, changes the display volume, or is counted
# in playback metrics.
#
# Each clip carries a bilingual caption — English title, Arabic title, and a
# transliteration + tagline line — rendered with the bundled Amiri font
# (assets/fonts/, OFL-licensed) so the Arabic shows on the Pi too.
#
# Sunrise (Shuruq): the sun rises behind a mosque silhouette as the dawn sky
# warms from indigo to gold. Fires at sunrise. Caption: "Sunrise (Shurūq) / شروق".
# SUNRISE_ENABLED=true
#
# Clip length in seconds (clamped 5-20; a non-numeric value falls back to the
# default). Default 12: ~1.5s absorbs Cast buffering, ~8s of rise, then a short
# hold. A 5s clip still works but loses much of the rise to connect latency.
# SUNRISE_CLIP_SECONDS=12
#
# How long before the cast to bake the clip. It is identical every day, so after
# the first bake this is a no-op.
# SUNRISE_PREBAKE_SEC=600
#
# Shift the sunrise cast, in seconds from sunrise (clamped -3600..7200).
# SUNRISE_OFFSET_SEC=0
#
# Caption tagline (default: "A new day begins").
# SUNRISE_TAGLINE=A new day begins
#
# Ishraq: a distinct, brighter clip — the sun already risen, climbing into a
# daylight-blue sky with radiating rays. Marks when the voluntary Duha prayer
# becomes permissible (~15-20 min after sunrise). Fires at sunrise + the offset
# below, so the default 1200s (20 min) lands it at Duha time. Caption:
# "Sunshine (Ishrāq) / إشراق". Set ISHRAQ_ENABLED=false to keep only the sunrise clip.
# ISHRAQ_ENABLED=true
# ISHRAQ_CLIP_SECONDS=12
# ISHRAQ_PREBAKE_SEC=600
# ISHRAQ_OFFSET_SEC=1200
# ISHRAQ_TAGLINE=The morning shines
