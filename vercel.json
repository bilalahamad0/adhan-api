{
  "version": 2,
  "builds": [
    {
      "src": "api/prayerTimes.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/project-status.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/prayerTimes",
      "dest": "/api/prayerTimes.js"
    },
    {
      "src": "/api/project-status",
      "dest": "/api/project-status.js"
    }
  ],
  "alias": ["adhan-api-mauve.vercel.app"]
}
